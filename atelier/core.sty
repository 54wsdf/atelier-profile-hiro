\NewDocumentCommand{\AtelierSetPublicationTheme}{m}{\renewcommand{\AtelierPublicationTheme}{#1}}
\NewDocumentCommand{\AtelierSetOrganizer}{m}{\renewcommand{\AtelierOrganizer}{#1}}

\NewDocumentCommand{\AtelierSetMasthead}{m}{\renewcommand{\AtelierMastheadFile}{#1}}
\NewDocumentCommand{\AtelierSetMastheadWidth}{m}{\renewcommand{\AtelierMastheadWidth}{#1}}
