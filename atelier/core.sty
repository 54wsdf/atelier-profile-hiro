\newcommand{\AtelierRenderMasthead}{%
  \ifAtelierMasthead
    \IfFileExists{\AtelierMastheadFile}{%
      \begin{center}
        \includegraphics[width=\AtelierMastheadWidth]{\AtelierMastheadFile}
      \end{center}
      \vspace{1.0em}%
    }{}%
  \fi
}

\newcommand{\AtelierMakeTitleFeature}{%
  % 防退化说明：titlepage 会重置页码；关闭封面页锚点可避免正文第一页与封面
  % 生成同名 page.1 目标，同时不改变作者看到的页码与标题页结构。
  \hypersetup{pageanchor=false}%
  \begin{titlepage}
    \raggedright
    \vspace*{0.035\textheight}
    \AtelierRenderMasthead
    {\small\bfseries\color{AtelierAccent}\MakeUppercase{\AtelierKicker}\par}
    \vspace{1.1em}
    {\huge\bfseries\@title\par}
    \ifstrempty{\AtelierSubtitle}{}{\vspace{0.7em}{\Large\color{AtelierMuted}\AtelierSubtitle\par}}
    \ifstrempty{\AtelierEnglishTitle}{}{\vspace{0.7em}{\large\itshape\color{AtelierMuted}\AtelierEnglishTitle\par}}
    \vfill
    {\large\@author\par}
    \ifstrempty{\AtelierAffiliation}{}{\vspace{0.35em}{\color{AtelierMuted}\AtelierAffiliation\par}}
    \ifstrempty{\AtelierContact}{}{\vspace{0.25em}{\small\color{AtelierMuted}\AtelierContact\par}}
    \vspace{0.75em}
    {\AtelierDate\par}
    \ifstrempty{\AtelierDocumentMeta}{}{\vspace{0.35em}{\small\color{AtelierMuted}\AtelierDocumentMeta\par}}
    \ifstrempty{\AtelierVersion}{}{\vspace{0.35em}{\small\color{AtelierMuted}\AtelierVersion\par}}
    \ifstrempty{\AtelierAuthorNote}{}{\vspace{0.65em}{\footnotesize\color{AtelierMuted}\AtelierAuthorNote\par}}
  \end{titlepage}
  \hypersetup{pageanchor=true}%
}

% Symposium / 研讨会刊页：紧凑呈现 publication、题名、作者和稿件元数据，
% 与 feature 的独立专题封面解决不同首页信息密度问题；两者都属于公共骨架。
\newcommand{\AtelierRenderSymposiumMasthead}{%
  \noindent
  \begin{minipage}[c]{0.35\textwidth}
    \raggedright
    \ifAtelierMasthead
      \IfFileExists{\AtelierMastheadFile}
        {\includegraphics[width=\AtelierSymposiumMastheadWidth]{\AtelierMastheadFile}}
        {\sffamily\bfseries\AtelierPublicationName}%
    \fi
  \end{minipage}\hfill
  \begin{minipage}[c]{0.60\textwidth}
    \raggedleft
    {\sffamily\fontsize{7.6}{9.2}\selectfont\color{AtelierMuted}\AtelierPublicationName\par}
    \vspace{1.1mm}
    {\sffamily\fontsize{6.8}{8.5}\selectfont\color{AtelierMuted}\AtelierPublicationTheme\par}
    \vspace{1mm}
    {\sffamily\fontsize{6.8}{8.5}\selectfont\color{AtelierMuted}\AtelierDate\quad\textperiodcentered\quad\AtelierOrganizer\par}
  \end{minipage}
  \par\vspace{4.2mm}
  \noindent{\color{AtelierRule}\rule{\textwidth}{0.38pt}}\par
}

\newcommand{\AtelierMakeTitleSymposium}{%
  \thispagestyle{empty}%
  \AtelierRenderSymposiumMasthead
  \vspace{12.5mm}
  \begingroup
    \raggedright
    {\sffamily\fontsize{7.3}{9}\selectfont\bfseries\color{AtelierMuted}\MakeUppercase{\AtelierKicker}\par}
    \vspace{3.8mm}
    {\bfseries\fontsize{27}{35}\selectfont\color{AtelierInk}\@title\par}
    \ifstrempty{\AtelierSubtitle}{}{\vspace{4.2mm}{\fontsize{12.6}{19.2}\selectfont\color{AtelierInk}\AtelierSubtitle\par}}
    \ifstrempty{\AtelierEnglishTitle}{}{\vspace{4mm}\begin{minipage}{0.88\textwidth}{\fontsize{9.7}{13.5}\selectfont\itshape\color{AtelierMuted}\AtelierEnglishTitle\par}\end{minipage}\par}
    \vspace{8.5mm}
    \noindent\begin{tabularx}{\textwidth}{@{}Xr@{}}
      {\fontsize{10.1}{13.4}\selectfont\@author} & {\sffamily\fontsize{6.9}{8.6}\selectfont\color{AtelierMuted}\MakeUppercase{\AtelierDocumentMeta}}\\[-0.15em]
      {\fontsize{8.8}{12.2}\selectfont\color{AtelierMuted}\AtelierAffiliation} & \\
      {\fontsize{8.5}{11.6}\selectfont\color{AtelierMuted}\AtelierContact} &
    \end{tabularx}\par
    \ifstrempty{\AtelierAuthorNote}{}{\vspace{2mm}{\fontsize{7.8}{10.5}\selectfont\color{AtelierMuted}\AtelierAuthorNote\par}}
  \endgroup
  \vspace{8.5mm}
}

% 标题页排版注册表。新增平行排版只注册名字与 renderer；公开排版仍须另配
% 独立样张和渲染验收，不能只注册一个没有可视证据的名字。
\NewDocumentCommand{\AtelierDeclareTitleLayout}{mm}{\csdef{atelier@titlelayout@#1}{#2}}
\NewDocumentCommand{\AtelierRenderTitleLayout}{m}{%
  \ifcsdef{atelier@titlelayout@#1}
    {\csuse{atelier@titlelayout@#1}}
    {\PackageError{atelier/core}{Unknown title layout '#1'}{Register it with \string\AtelierDeclareTitleLayout\space before use.}}%
}
\newcommand{\AtelierTitleLayoutName}{feature}
\NewDocumentCommand{\AtelierUseTitleLayout}{m}{%
  \ifcsdef{atelier@titlelayout@#1}{%
    \renewcommand{\AtelierTitleLayoutName}{#1}%
    \renewcommand{\maketitle}{\AtelierRenderTitleLayout{#1}}%
  }{%
    \PackageError{atelier/core}{Unknown title layout '#1'}{Register it with \string\AtelierDeclareTitleLayout\space before use.}%
  }%
}
\AtelierDeclareTitleLayout{feature}{\AtelierMakeTitleFeature}
\AtelierDeclareTitleLayout{symposium}{\AtelierMakeTitleSymposium}

% 保留显式调用名的既有语义：它继续表示 feature，不随 class option 漂移。
\newcommand{\AtelierMakeTitle}{\AtelierMakeTitleFeature}
\newcommand{\AtelierUseFeatureTitleLayout}{\AtelierUseTitleLayout{feature}}
\newcommand{\AtelierUseSymposiumTitleLayout}{\AtelierUseTitleLayout{symposium}}

\NewDocumentCommand{\AtelierLead}{m}{%
  \par\noindent{\large\color{AtelierMuted}#1}\par\medskip
}

